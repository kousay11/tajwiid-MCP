# Optional: copy to .env, then explicitly export it in your shell.
# The server does not automatically load .env files.
WIRDI_MCP_LOG_LEVEL=INFO
# Nothing else is needed: the Quran text, the page map and the mapping resolver are bundled.
# Optional override: verify against a Wirdi AI checkout (read-only; never a database URL).
# WIRDI_AI_ROOT=/absolute/path/to/wirdi-Ai
# Optional: another knowledge/ directory (rules, source metadata, local page stores).
# WIRDI_KNOWLEDGE_ROOT=/absolute/path/to/wirdi-mcp/knowledge
